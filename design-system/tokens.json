  "brand": {
    "$description": "Capa TENANT. El negocio solo define brand.primary, brand.logo y brand.name; el resto se DERIVA (en el servidor al guardar) con las reglas de design-system/README.md §Marca del tenant. Valores por defecto = acento de la plataforma.",
    "primary": {
      "$value": "{color.platform.accent}",
      "$type": "color",
      "$description": "Color elegido por el negocio. ÚNICO token de color sobreescribible por el tenant.",
      "$extensions": {
        "com.coop-agents.tenant": {
          "overridable": true
        }
      }
    },
    "solid": {
      "$value": "{brand.primary}",
      "$type": "color",
      "$description": "Relleno de botones/destacados. = primary si on-primary logra ≥4.5:1; si no, primary oscurecido en pasos de 2 % hacia negro hasta ≥4.5:1 con blanco.",
      "$extensions": {
        "com.coop-agents.tenant": {
          "derived": "solid(primary)"
        }
      }
    },
    "on-primary": {
      "$value": "{color.stone.0}",
      "$type": "color",
      "$description": "Texto/ícono sobre brand.solid: blanco (#ffffff) o casi negro (#111111), el de mayor contraste (≥4.5:1).",
      "$extensions": {
        "com.coop-agents.tenant": {
          "derived": "onColor(solid)"
        }
      }
    },
    "primary-hover": {
      "$value": "{color.sage.700}",
      "$type": "color",
      "$description": "Hover: si on-primary es blanco, solid mezclado 15 % con negro; si es casi negro, solid mezclado 30 % con blanco.",
      "$extensions": {
        "com.coop-agents.tenant": {
          "derived": "hover(solid,on)"
        }
      }
    },
    "text": {
      "$value": "{color.sage.600}",
      "$type": "color",
      "$description": "Links y texto de marca: primary oscurecido en pasos de 2 % hacia negro hasta ≥ 4.5:1 contra TODAS las superficies donde aparece (surface.default, surface.canvas/subtle y brand.subtle).",
      "$extensions": {
        "com.coop-agents.tenant": {
          "derived": "textOnLight(primary)"
        }
      }
    },
    "text-hover": {
      "$value": "{color.sage.700}",
      "$type": "color",
      "$description": "Hover de links de marca: brand.text mezclado 15 % con negro (siempre ≥ contraste de brand.text).",
      "$extensions": {
        "com.coop-agents.tenant": {
          "derived": "mix(text,#000,0.15)"
        }
      }
    },
    "subtle": {
      "$value": "{color.sage.50}",
      "$type": "color",
      "$description": "Tinte suave para seleccionado/fondos: primary 12 % + surface.default 88 %.",
      "$extensions": {
        "com.coop-agents.tenant": {
          "derived": "tint(primary,0.12)"
        }
      }
    },
    "border": {
      "$value": "{brand.text}",
      "$type": "color",
      "$description": "Borde de opción seleccionada (≥3:1 garantizado porque brand.text ≥4.5:1).",
      "$extensions": {
        "com.coop-agents.tenant": {
          "derived": "= text"
        }
      }
    },
