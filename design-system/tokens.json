      "$extensions": {
        "com.coop-agents.media": {
          "query": "(max-width: 63.9375rem), (pointer: coarse)",
          "replaces": "density.control-height",
          "min": "{size.target.comfortable}"
        }
      }
    },
    "row-height-touch": {
      "$value": "56px",
      "$type": "dimension",
